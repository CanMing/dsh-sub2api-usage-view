{
  "name": "dsh-sub2api-usage-view",
  "version": "0.1.1",
  "description": "Sub2API subscription quota and reset countdowns in the DeepSeek Harness conversation footer",
  "type": "module",
  "license": "MIT",
  "author": "CanMing",
  "main": "lib/index.js",
  "exports": {".": "./lib/index.js", "./client": "./lib/client.js", "./package.json": "./package.json"},
  "files": ["lib/*.js", "client.js", "scripts/build-client.mjs", "cordis.patch.yml", "README.md", "LICENSE", "CHANGELOG.md"],
  "engines": {"node": ">=22.19.0", "dsh": "0.2.1-rc.5"},
  "keywords": ["deepseek-harness", "dsh", "sub2api", "codex", "claude", "usage", "quota"],
  "repository": {"type": "git", "url": "git+https://github.com/CanMing/dsh-sub2api-usage-view.git"},
  "bugs": {"url": "https://github.com/CanMing/dsh-sub2api-usage-view/issues"},
  "dsh": {
    "bundle": {"patch": "./cordis.patch.yml"},
    "client": {
      "inject": ["@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-ui-settings", "@deepseek-ai/dsh-client-ui-plugin-manager", "@deepseek-ai/dsh-api-remotes"],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "check": "node --check lib/index.js && node --check lib/usage.js && node --check lib/routes.js && node --check lib/client.js",
    "test": "node --test --test-isolation=none --test-concurrency=1 test/*.test.js",
    "prepack": "npm run build && npm run check"
  },
  "dependencies": {"@deepseek-ai/schemastery": "~3.18.5"},
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.5",
    "@deepseek-ai/dsh-launch-environment": "0.2.1-rc.5",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.5",
    "@deepseek-ai/cordis-plugin-loader": "~1.0.6",
    "js-yaml": "^4.1.0"
  }
}
